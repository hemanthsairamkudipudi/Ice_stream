# IceStream Generator Configuration

EVENTS_PER_SECOND=10
TOTAL_EVENTS=100
CONTINUOUS_MODE=false

# Anomaly injection rates
NULL_TAX_RATE=0.03
SCHEMA_DRIFT_RATE=0.01
DUPLICATE_RATE=0.01
INVALID_VALUE_RATE=0.01

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=checkout-topic

# Data quality
NULL_THRESHOLD=0.10
ERROR_RATE_THRESHOLD=0.02